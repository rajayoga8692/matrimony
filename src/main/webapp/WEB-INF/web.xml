<?xml version="1.0" encoding="UTF-8"?>
<web-app id="WebApp_ID" version="2.4"
	xmlns="http://java.sun.com/xml/ns/j2ee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://java.sun.com/xml/ns/j2ee http://java.sun.com/xml/ns/j2ee/web-app_2_4.xsd">
	<display-name>Jersey Example</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>
	
	
	<context-param>
		<param-name>contextConfigLocation</param-name>
		<param-value>
			classpath*:spring-model.xml
		</param-value>
	</context-param>
	
	<listener>
		<listener-class>
			org.springframework.web.context.ContextLoaderListener
		</listener-class>
	</listener> 
	
	<servlet>
		<servlet-name>jersey</servlet-name>
		<servlet-class>
                    com.sun.jersey.spi.spring.container.servlet.SpringServlet
        </servlet-class>
		<init-param>
		     <param-name>com.sun.jersey.config.property.packages</param-name>
		     <param-value>utility;org.codehaus.jackson.jaxrs</param-value>
		</init-param>
		<!-- <init-param>
          <param-name>com.sun.jersey.api.json.POJOMappingFeature</param-name>
          <param-value>true</param-value>
        </init-param> -->

	</servlet>
	
	<servlet>
		<display-name>OpenFile</display-name>
		<servlet-name>OpenFile</servlet-name>
		<servlet-class>utility.action.OpenFile</servlet-class>
	</servlet>
	
	<servlet-mapping>
		<servlet-name>OpenFile</servlet-name>
		<url-pattern>/OpenFile</url-pattern>
	</servlet-mapping>
	<servlet-mapping>
		<servlet-name>jersey</servlet-name>
		<url-pattern>/rest/*</url-pattern>
	</servlet-mapping>
</web-app>